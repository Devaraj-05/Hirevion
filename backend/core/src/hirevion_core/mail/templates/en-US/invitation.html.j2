{% extends "_layout.html.j2" %}
{% block body %}
<p>Hello {{ name }},</p>
<p>{{ inviter }} invited you to join {{ organization }} on Hirevion.</p>
<p><a href="{{ link }}" style="display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;padding:10px 16px;border-radius:6px">Set your password</a></p>
<p style="font-size:13px;color:#475569">Or paste this link into your browser: {{ link }}</p>
<p>The link works once and expires in {{ hours }} hours. If it expires, ask {{ inviter }} to send a new one. If you weren't expecting this invitation, you can ignore this email.</p>
{% endblock %}
