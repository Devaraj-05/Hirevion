{% extends "_layout.html.j2" %}
{% block body %}
<p>Hello {{ name }},</p>
<p>Someone asked to reset the password for your Hirevion account. If it was you, choose a new password:</p>
<p><a href="{{ link }}" style="display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;padding:10px 16px;border-radius:6px">Choose a new password</a></p>
<p style="font-size:13px;color:#475569">Or paste this link into your browser: {{ link }}</p>
<p>The link works once and expires in {{ minutes }} minutes. If you didn't ask, ignore this email: your password stays as it is.</p>
{% endblock %}
