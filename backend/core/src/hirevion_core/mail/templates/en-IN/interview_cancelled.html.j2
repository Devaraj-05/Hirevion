{% extends "_layout.html.j2" %}
{% block body %}
<p>Hello {{ name }},</p>
<p>{{ organization }} cancelled your interview for the {{ job }} role, which was due in this window: {{ window }}.</p>
{% if reason %}<p>They said: {{ reason }}</p>{% endif %}
<p>You don't need to do anything. If you have questions, write to <a href="mailto:{{ support_email }}">{{ support_email }}</a>.</p>
{% endblock %}
