{% extends "_layout.html.j2" %}
{% block body %}
<p>Hello {{ name }},</p>
<p>Confirm this address for your Hirevion account:</p>
<p><a href="{{ link }}" style="display:inline-block;background:#4f46e5;color:#ffffff;text-decoration:none;padding:10px 16px;border-radius:6px">Confirm this address</a></p>
<p style="font-size:13px;color:#475569">Or paste this link into your browser: {{ link }}</p>
<p>The link works once and expires in {{ hours }} hours. Until you confirm, your account keeps its current address.</p>
{% endblock %}
