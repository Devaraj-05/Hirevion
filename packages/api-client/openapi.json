{
  "components": {
    "schemas": {
      "Liveness": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Liveness",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": true,
        "description": "An RFC 9457 problem; codes may add extension members (e.g. `errors`, `checks`).",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "trace_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Trace Id"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "checks": {
            "additionalProperties": {
              "type": "string"
            },
            "title": "Checks",
            "type": "object"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "ServerTime": {
        "properties": {
          "received_at_ms": {
            "description": "Server clock (Unix ms) when the request arrived.",
            "title": "Received At Ms",
            "type": "integer"
          },
          "sent_at_ms": {
            "description": "Server clock (Unix ms) when the response was built.",
            "title": "Sent At Ms",
            "type": "integer"
          }
        },
        "required": [
          "received_at_ms",
          "sent_at_ms"
        ],
        "title": "ServerTime",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Hirevion API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "description": "The process is up. It checks nothing else, so a restart can't fix what it reports.",
        "operationId": "get_liveness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Liveness"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error, as an RFC 9457 problem"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error, as an RFC 9457 problem"
          }
        },
        "summary": "Get Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "PostgreSQL and Valkey answer; 503 `service-unavailable` names what doesn't.",
        "operationId": "get_readiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error, as an RFC 9457 problem"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error, as an RFC 9457 problem"
          }
        },
        "summary": "Get Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/time": {
      "get": {
        "description": "The server clock, for estimating this client's clock offset.",
        "operationId": "get_server_time",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerTime"
                }
              }
            },
            "description": "Successful Response"
          },
          "4XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Client error, as an RFC 9457 problem"
          },
          "5XX": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Server error, as an RFC 9457 problem"
          }
        },
        "summary": "Get Server Time",
        "tags": [
          "clock"
        ]
      }
    }
  }
}
