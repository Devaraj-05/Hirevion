# Local HTTPS for *.hirevion.localhost using Caddy's own CA (trust it with `uv run hv trust-ca`).
# Application upstreams (host ports 3000, 5174, 8000, 8001) come online in later sub-projects.
{
	local_certs
}

app.hirevion.localhost {
	handle /api/* {
		reverse_proxy host.docker.internal:8000
	}
	handle /ws/* {
		reverse_proxy host.docker.internal:8001
	}
	handle {
		reverse_proxy host.docker.internal:3000
	}
}

# The candidate portal (ADR-0022) reaches only the portal's own API routes.
candidate.hirevion.localhost {
	handle /api/v1/portal/* {
		reverse_proxy host.docker.internal:8000
	}
	handle /api/* {
		respond 404
	}
	handle {
		reverse_proxy host.docker.internal:3000
	}
}

api.hirevion.localhost {
	reverse_proxy host.docker.internal:8000
}

ws.hirevion.localhost {
	reverse_proxy host.docker.internal:8001
}

# The third-eye phone page (SP-13): LiveKit signalling and the phone's two API calls share its
# origin; no other API route is reachable from it.
eye.hirevion.localhost {
	@phone path /api/v1/third-eye/redeem /api/v1/third-eye/rejoin
	handle @phone {
		reverse_proxy host.docker.internal:8000
	}
	handle /api/* {
		respond 404
	}
	handle /rtc* {
		reverse_proxy livekit:7880
	}
	handle {
		reverse_proxy host.docker.internal:5174
	}
}

livekit.hirevion.localhost {
	reverse_proxy livekit:7880
}

storage.hirevion.localhost {
	reverse_proxy azurite:10000
}

mail.hirevion.localhost {
	reverse_proxy mailpit:8025
}

grafana.hirevion.localhost {
	reverse_proxy otel-lgtm:3000
}

errors.hirevion.localhost {
	reverse_proxy glitchtip:8000
}

downloads.hirevion.localhost {
	root * /srv/downloads
	file_server browse
}

# Plain HTTP for Cloudflare quick tunnels (`uv run hv eye-tunnel`); the tunnel gives the phone
# HTTPS. /rtc is LiveKit signalling, so the phone page and LiveKit share one origin; the phone's
# two API calls (SP-13) are the only API routes the tunnel reaches.
http://:8088 {
	@phone path /api/v1/third-eye/redeem /api/v1/third-eye/rejoin
	handle @phone {
		reverse_proxy host.docker.internal:8000
	}
	handle /api/* {
		respond 404
	}
	handle /rtc* {
		reverse_proxy livekit:7880
	}
	handle {
		reverse_proxy host.docker.internal:5174
	}
}
