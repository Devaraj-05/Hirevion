# Local development settings.
# Run `uv run hv init-env` to create the gitignored .env with fresh local secrets,
# or `uv run hv env-sync` to add new settings to an existing .env. Never commit .env.

# AI vendors
# Development and testing: Gemini (LLM, embeddings, vision) and Deepgram (speech). Required.
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
# Production LLM. Optional locally; set it to compare OpenAI during testing.
OPENAI_API_KEY=

# Local infrastructure (secrets are generated by `hv init-env` / `hv env-sync`)
POSTGRES_USER=hirevion
POSTGRES_DB=hirevion
POSTGRES_PASSWORD=
VALKEY_PASSWORD=
AZURE_STORAGE_ACCOUNT=hirevion
AZURE_STORAGE_KEY=
LIVEKIT_API_KEY=hirevion-local
LIVEKIT_API_SECRET=
GLITCHTIP_SECRET_KEY=

# This PC's LAN IP, so a phone on the same Wi-Fi can reach LiveKit (third-eye testing)
LIVEKIT_NODE_IP=127.0.0.1
