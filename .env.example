# Local development settings.
# Run `uv run hv init-env` to create the gitignored .env with fresh local secrets,
# or `uv run hv env-sync` to add new settings to an existing .env. Never commit .env.

# AI vendors
# Development and testing: Gemini (LLM, embeddings, vision) and Deepgram (speech). Required.
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
# Production LLM. Optional locally; set it to compare OpenAI during testing.
OPENAI_API_KEY=

# Local infrastructure (secrets are generated by `hv init-env` / `hv env-sync`)
POSTGRES_USER=hirevion
POSTGRES_DB=hirevion
POSTGRES_PASSWORD=
# The application and outbox-relay roles; `uv run hv migrate` creates them.
POSTGRES_APP_PASSWORD=
POSTGRES_RELAY_PASSWORD=
VALKEY_PASSWORD=
AZURE_STORAGE_ACCOUNT=hirevion
AZURE_STORAGE_KEY=
LIVEKIT_API_KEY=hirevion-local
LIVEKIT_API_SECRET=
GLITCHTIP_SECRET_KEY=

# This PC's LAN IP, so a phone on the same Wi-Fi can reach LiveKit (third-eye testing)
LIVEKIT_NODE_IP=127.0.0.1

# Voice agent, as measured by the voice-latency benchmark (ADR-0005). Pin exact model
# versions: Google retires models for new users (gemini-2.5-flash already returns 404).
LIVEKIT_URL=ws://127.0.0.1:7880
HV_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
HV_LLM_MODEL_FAST=gemini-3.1-flash-lite
HV_STT_MODEL=nova-3
HV_STT_LANGUAGE=en
HV_TTS_VOICE=aura-2-thalia-en
# multilingual = LiveKit's local semantic turn detector (run `download-files` once).
HV_TURN_DETECTION=multilingual
HV_ENDPOINTING_MIN_DELAY=0.5
HV_PREEMPTIVE_GENERATION=true
HV_AGENT_MAX_SESSIONS=10
HV_METRICS_FILE=tools/voice_bench/.cache/agent-metrics.jsonl
