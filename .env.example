# Local development settings.
# Run `uv run hv init-env` to create the gitignored .env with fresh local secrets,
# or `uv run hv env-sync` to add new settings to an existing .env. Never commit .env.

# AI vendors
# Development and testing: Gemini (LLM, embeddings, vision) and Deepgram (speech). Required.
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
# Production LLM. Optional locally; set it to compare OpenAI during testing.
OPENAI_API_KEY=

# Local infrastructure (secrets are generated by `hv init-env` / `hv env-sync`)
POSTGRES_USER=hirevion
POSTGRES_DB=hirevion
POSTGRES_PASSWORD=
# The application and outbox-relay roles; `uv run hv migrate` creates them.
POSTGRES_APP_PASSWORD=
POSTGRES_RELAY_PASSWORD=
VALKEY_PASSWORD=
AZURE_STORAGE_ACCOUNT=hirevion
AZURE_STORAGE_KEY=
LIVEKIT_API_KEY=hirevion-local
LIVEKIT_API_SECRET=
GLITCHTIP_SECRET_KEY=

# This PC's LAN IP, so a phone on the same Wi-Fi can reach LiveKit (third-eye testing)
LIVEKIT_NODE_IP=127.0.0.1

# Voice agent, as measured by the voice-latency benchmark (ADR-0005). Pin exact model
# versions: Google retires models for new users (gemini-2.5-flash already returns 404).
LIVEKIT_URL=ws://127.0.0.1:7880
HV_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
HV_LLM_MODEL_FAST=gemini-3.1-flash-lite
HV_STT_MODEL=nova-3
HV_STT_LANGUAGE=en
HV_TTS_VOICE=aura-2-thalia-en
# multilingual = LiveKit's local semantic turn detector (run `download-files` once).
HV_TURN_DETECTION=multilingual
HV_ENDPOINTING_MIN_DELAY=0.5
HV_PREEMPTIVE_GENERATION=true
HV_AGENT_MAX_SESSIONS=10
# The interview engine (ADR-0030). The API dispatches this agent to each voice interview.
HV_AGENT_NAME=hirevion-interviewer
# What the desktop connects to (empty: LIVEKIT_URL). Through Caddy: wss://livekit.hirevion.localhost
HV_LIVEKIT_PUBLIC_URL=
# `fake` runs text-mode interviews without LiveKit (CI, the simulator); never in production.
HV_MEDIA_BACKEND=livekit
HV_METRICS_FILE=tools/voice_bench/.cache/agent-metrics.jsonl

# AI provider layer (ADR-0011). dev = Gemini + Deepgram, production = OpenAI + Deepgram,
# mock = no network. The strong model screens and evaluates; the vision model reads scans.
HV_AI_PROFILE=dev
HV_LLM_MODEL_STRONG=gemini-3.8-flash
HV_VISION_MODEL=gemini-3.1-flash-lite
HV_EMBEDDING_MODEL=gemini-embedding-2
HV_EMBEDDING_DIMENSIONS=1536
# Monthly AI spend allowed per organisation without its own quota; calls stop when it's reached.
HV_AI_MONTHLY_BUDGET_USD=50

# Observability (ADR-0010). Set OTEL_SDK_DISABLED=false while `uv run hv up --obs` runs Grafana,
# to send traces, metrics and logs from `hv api` there.
OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
HV_ENVIRONMENT=development

# Sign-in and email (SP-02, ADR-0013). Locally Mailpit catches every email:
# https://mail.hirevion.localhost
HV_WEB_ORIGIN=https://app.hirevion.localhost
HV_SMTP_HOST=127.0.0.1
HV_SMTP_PORT=1025
HV_MAIL_FROM="Hirevion <no-reply@hirevion.localhost>"
# Candidate invitations (SP-07a, ADR-0020): links point at the candidate portal; the support
# address is used when an organisation hasn't set its own.
HV_CANDIDATE_ORIGIN=https://candidate.hirevion.localhost
HV_SUPPORT_EMAIL=support@hirevion.localhost
# Candidate desktop sign-in (SP-07c, ADR-0021): the ES256 key that signs candidate tokens
# (generated; base64 PKCS #8), and the issuer the tokens name.
HV_CANDIDATE_TOKEN_KEY=
HV_CANDIDATE_TOKEN_ISSUER=https://api.hirevion.localhost
# Check new passwords against Have I Been Pwned too (only a 5-character hash prefix leaves this PC).
HV_HIBP_ENABLED=true
# Run the outbox relay and the mail consumer inside `hv api`; set false and run `hv worker` instead.
HV_API_RUN_WORKERS=true
# The password of the development users `uv run hv seed-identity` creates (generated).
HV_SEED_PASSWORD=

# Documents (SP-04, ADR-0015): uploads are virus-scanned by ClamAV (compose profile `core`).
# Scanning may be switched off outside production while ClamAV downloads its signatures.
HV_CLAMAV_HOST=127.0.0.1
HV_CLAMAV_PORT=3310
HV_DOCUMENTS_SCAN=true
