#!/bin/sh
# Blocks pushing commits with another identity or Claude/Anthropic attribution (see CLAUDE.md).
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>

expected="Devaraj-05 <padma.devaraj1800@gmail.com>"
attribution='co-authored-by:.*(claude|anthropic)|noreply@anthropic\.com|generated with .*claude|claude\.com/claude-code'
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;  # branch deletion: nothing to check
  esac
  case "$remote_sha" in
    *[!0]*) commits=$(git rev-list "$remote_sha..$local_sha" 2>/dev/null) || commits=$(git rev-list "$local_sha" --not --remotes) ;;
    *) commits=$(git rev-list "$local_sha" --not --remotes) ;;
  esac
  for commit in $commits; do
    author=$(git log -1 --format='%an <%ae>' "$commit")
    committer=$(git log -1 --format='%cn <%ce>' "$commit")
    if [ "$author" != "$expected" ] || [ "$committer" != "$expected" ]; then
      echo "pre-push: $commit has author '$author' and committer '$committer'; expected '$expected'." >&2
      status=1
    fi
    if git log -1 --format='%B' "$commit" | grep -Eiq "$attribution"; then
      echo "pre-push: $commit contains Claude/Anthropic attribution." >&2
      status=1
    fi
  done
done

exit $status
